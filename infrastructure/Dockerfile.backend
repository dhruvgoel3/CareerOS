FROM node:22-alpine AS builder

WORKDIR /app
COPY backend/package*.json ./
RUN npm ci

COPY backend/ ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --only=production
COPY --from=builder /app/dist ./dist

ENV PORT=5001
ENV NODE_ENV=production
EXPOSE 5001

CMD ["node", "dist/server.js"]
